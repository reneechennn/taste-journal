---
import Icon from './Icon.astro'
import type { Recipe } from '../lib/types'
import { sp } from '../lib/parser'
import { cardEmoji } from '../lib/emoji'

interface Props {
  recipe: Recipe
}
const { recipe: r } = Astro.props
const url = (r.photoThumb && `/photos/thumbs/${encodeURIComponent(r.photoThumb)}`) || (r.photo && `/photos/${encodeURIComponent(r.photo)}`) || ''
---
<article class="card overflow-hidden flex flex-col">
  <div class="cursor-pointer flex flex-col flex-1" data-action="open-recipe" data-slug={r.slug}>
    {
      url ? (
        <img src={url} alt={r.title} loading="lazy" class="w-full aspect-[4/3] object-cover" />
      ) : (
        <div class="w-full aspect-[4/3] bg-cream flex items-center justify-center">
          <span class="text-[44px] leading-none" aria-hidden="true">{cardEmoji(r)}</span>
        </div>
      )
    }
    <div class="p-4 sm:p-5 flex flex-col flex-1">
      <div class="flex flex-wrap gap-1.5">
        <span class="pill pill-type">{r.cuisine}</span>
        <span class="pill pill-cuisine">{r.type}</span>
      </div>
      <h3 class="mt-3 font-serif text-[18px] sm:text-[21px] lg:text-[23px] font-bold leading-snug">{sp(r.title)}</h3>
      {
        r.time ? (
          <div class="mt-2 flex items-center gap-1.5 text-[13px] sm:text-[14px] text-soft">
            <Icon name="clock" size={15} />
            約 {r.time} 分鐘
          </div>
        ) : null
      }
    </div>
  </div>
</article>
