---
import '../styles/global.css'
import Icon from '../components/Icon.astro'
import IconSprite from '../components/IconSprite.astro'
import TabBar from '../components/TabBar.astro'

interface Props {
  title?: string
  description?: string
}
const { title = '味覺手帳', description = '溫潤的個人食譜手帳：今日餐點、食譜收藏與採購清單。' } = Astro.props

const path = Astro.url.pathname
const tabs = [
  { href: '/', label: '首頁' },
  { href: '/search', label: '搜尋' },
  { href: '/shopping', label: '採購清單' },
]
const active = (href: string) => (href === '/' ? path === '/' : path.startsWith(href))
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FAF6EF" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@400;600;700;900&display=swap"
      rel="stylesheet"
    />
    <title>{title === '味覺手帳' ? '味覺手帳 Taste Journal' : `${title} · 味覺手帳`}</title>
  </head>
  <body>
    <IconSprite />

    <header class="relative z-10 bg-card border-b border-line">
      <div class="max-w-[1400px] mx-auto px-4 md:px-8 min-h-[68px] md:min-h-[80px] flex items-center justify-between gap-3 md:gap-6">
        <div class="flex items-center gap-3 md:gap-7 min-w-0">
          <a href="/" class="shrink-0 py-3">
            <span class="block font-serif text-[22px] md:text-[26px] font-bold leading-tight text-accent-deep">味覺手帳</span>
            <span class="flex justify-between text-[9px] md:text-[10px] text-faint leading-none mt-1" aria-label="TASTE JOURNAL">
              {Array.from('TASTE JOURNAL').map((ch) => ch === ' ' ? <span class="w-[0.25em]" aria-hidden="true"></span> : <span aria-hidden="true">{ch}</span>)}
            </span>
          </a>
          <nav class="hidden md:flex items-center gap-1 bg-cream/70 border border-line rounded-full p-1" aria-label="主導覽">
            {
              tabs.map((t) => (
                <a
                  href={t.href}
                  class:list={[
                    'px-5 py-2 rounded-full text-[15px] transition-all',
                    active(t.href)
                      ? 'bg-card text-ink font-medium shadow-[0_1px_4px_rgba(70,55,40,0.12)]'
                      : 'text-soft hover:text-ink',
                  ]}
                  aria-current={active(t.href) ? 'page' : undefined}
                >
                  {t.label}
                </a>
              ))
            }
          </nav>
        </div>
        <div class="flex items-center gap-2 md:gap-3">
          <button id="auth-chip" data-action="login" class="chip !text-[13px] !border-transparent !bg-transparent !px-2">
            <Icon name="login" size={15} />
            登入
          </button>
          <a href="/edit" class="hidden md:inline-flex btn-accent !py-2 !px-5 text-[15px]" aria-label="新增食譜">
            <Icon name="plus" size={16} />
            新增食譜
          </a>
          <a
            href="/edit"
            class="md:hidden quick-btn !w-[42px] !h-[42px] !bg-accent !text-white !border-accent"
            aria-label="新增食譜"
            title="新增食譜"
          >
            <Icon name="plus" size={20} />
          </a>
        </div>
      </div>
    </header>

    <main class="relative z-[1] max-w-[1400px] mx-auto px-4 md:px-8 pt-6 md:pt-8 pb-28 md:pb-16 min-h-[60vh]">
      <slot />
    </main>

    <TabBar />

    <div id="modal-root"></div>
    <div id="confirm-root"></div>
    <div id="toast-root" class="fixed left-1/2 -translate-x-1/2 bottom-24 md:bottom-8 z-[80] flex flex-col items-center gap-2 pointer-events-none"></div>

    <script>
      import { initUI } from '../lib/ui'
      import { initCustomSelects } from '../lib/customSelect'
      initUI()
      initCustomSelects()
    </script>
  </body>
</html>
